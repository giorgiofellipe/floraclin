# Meta Conversions API

# Random 32-byte hex string. Keys the HMAC that derives external_id from a
# prospect id. Must NEVER change once set: changing it re-identifies every
# patient to Meta as a new person.
META_EXTERNAL_ID_SECRET=

# Gates the reconciliation sweep in the meta-events cron. Prevents a backfill
# of invented conversions on first deploy.
META_EVENTS_START_AT=
