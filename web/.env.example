# Meta Conversions API

# Random 32-byte hex string. Keys the HMAC that derives external_id from a
# prospect id. Must NEVER change once set: changing it re-identifies every
# patient to Meta as a new person.
META_EXTERNAL_ID_SECRET=

# Gates the reconciliation sweep in the meta-events cron. Prevents a backfill
# of invented conversions on first deploy. Must be a full ISO timestamp with an
# offset (2026-01-01T00:00:00Z); a bare YYYY-MM-DD is rejected and the sweep
# does not run.
META_EVENTS_START_AT=

# Meta app id used for the OAuth connect flow (Facebook Login for Business).
META_APP_ID=

# App secret for the Meta app; also verifies WhatsApp webhook signatures.
META_APP_SECRET=

# OAuth callback URL registered on the Meta app; defaults to NEXT_PUBLIC_APP_URL + /api/integrations/meta/auth/callback when unset.
META_OAUTH_REDIRECT_URI=

# Stored credentials

# AES-256-GCM key for the OAuth tokens in meta_connections and
# calendar_connections. 32 bytes of hex (`openssl rand -hex 32`); lose it and
# every stored token is unrecoverable, so every clinic has to reconnect.
TOKEN_ENCRYPTION_KEY=
